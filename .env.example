# --- LLM ---
ANTHROPIC_API_KEY=test

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=      # only this chat id may talk to the bot

# --- Vault ---
VAULT_PATH=/absolute/path/to/your/obsidian/vault

# --- Google Calendar (Phase 2) ---
GOOGLE_CREDENTIALS_PATH=./secrets/google_credentials.json
GOOGLE_TOKEN_PATH=./secrets/google_token.json    # written by scripts/google_auth.py
GOOGLE_CALENDAR_ID=primary

# --- Runtime ---
USER_NAME=                     # optional; used in proactive messages ("⚡ İkbal, ...")
INDEX_PATH=.index               # derived embedding index (rebuild: scripts/rebuild_index.py)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RECALL_MIN_SCORE=0.42          # related notes below this similarity stay out of the prompt
STATE_DB_PATH=state.db        # SQLite operational state (reminders, history)
SCHEDULER_INTERVAL_S=60        # proactive tick, seconds (when proactive is on)
QUIET_HOURS=23:00-08:00
JOURNAL_CHECK_TIME=21:00         # evening nudge if the journal is still empty
POLICY_MAX_NUDGES_PER_DAY=3    # assistant-initiated messages; user reminders are exempt
TIMEZONE=Europe/Istanbul
